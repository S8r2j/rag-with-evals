# Copy to .env and adjust. Never commit the real .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Inside Docker Compose the database host is "db"; use "localhost" when
# running the API directly on your machine.
DATABASE_URL=postgresql+asyncpg://rag:rag@db:5432/rag

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

STORAGE_DIR=data/uploads
MAX_UPLOAD_MB=20
MAX_PAGES=1000

# Chunking, measured in tokens of the tokenizer below.
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
TOKENIZER_ENCODING=o200k_base

# JSON list, e.g. ["http://localhost:5173"]
CORS_ORIGINS=[]
