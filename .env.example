# Copy to .env and adjust. Never commit the real .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Inside Docker Compose the database host is "db"; use "localhost" when
# running the API directly on your machine.
DATABASE_URL=postgresql+asyncpg://rag:rag@db:5432/rag

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

STORAGE_DIR=data/uploads
MAX_UPLOAD_MB=20
MAX_PAGES=1000

# Chunking, measured in tokens of the tokenizer below.
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
TOKENIZER_ENCODING=o200k_base

# JSON list, e.g. ["http://localhost:5173"]
CORS_ORIGINS=[]

# Embeddings. Use EMBEDDING_PROVIDER=hashing to run without an API key
# (offline development only: it does not understand meaning).
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
EMBEDDING_BATCH_SIZE=128

# Answers. Use CHAT_PROVIDER=extractive to run without an API key
# (offline development only: it quotes a passage instead of answering).
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-6-luna
CHAT_REASONING_EFFORT=low
CHAT_MAX_OUTPUT_TOKENS=4000

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_DISTANCE=0.8
RETRIEVAL_EF_SEARCH=100
QUESTION_MAX_CHARS=2000

# Background processing. Inside Docker Compose the host is "redis".
REDIS_URL=redis://redis:6379/0
INGESTION_MAX_RETRIES=4
INGESTION_LEASE_SECONDS=1800

# Live status stream (server-sent events)
SSE_HEARTBEAT_SECONDS=15
SSE_MAX_STREAM_SECONDS=1800
